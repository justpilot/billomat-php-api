{
  "name": "justpilot/billomat-php-api",
  "description": "Unofficial PHP 8.5+ SDK for the Billomat API, works with any PSR-18 HTTP client.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/justpilot/billomat-php-api",
  "keywords": [
    "billomat",
    "api",
    "api-client",
    "sdk",
    "client",
    "invoice",
    "rechnung",
    "accounting",
    "buchhaltung",
    "psr-18",
    "psr-3",
    "psr-14",
    "money",
    "e-invoice",
    "typed",
    "readonly",
    "php85",
    "dach",
    "gobd"
  ],
  "support": {
    "issues": "https://github.com/justpilot/billomat-php-api/issues",
    "source": "https://github.com/justpilot/billomat-php-api",
    "docs": "https://billomat-php.justpilot.io"
  },
  "require": {
    "php": "^8.5",
    "ext-bcmath": "*",
    "php-http/discovery": "^1.20",
    "psr/event-dispatcher": "^1.0",
    "psr/http-client": "^1.0.3",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35",
    "nyholm/psr7": "^1.8",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-phpunit": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpstan/phpstan-symfony": "^2.1",
    "phpunit/phpunit": "^13.4",
    "rector/rector": "^2.7",
    "symfony/css-selector": "^8.1",
    "symfony/dom-crawler": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/http-client": "^8.1",
    "symfony/var-dumper": "^8.1"
  },
  "suggest": {
    "symfony/http-client": "Default PSR-18 client; the SDK applies BillomatConfig::$timeout to it (needs nyholm/psr7 or another PSR-17 implementation)",
    "guzzlehttp/guzzle": "Alternative PSR-18 client",
    "rector/rector": "Runs rector/upgrade-4.0.php, which automates the mechanical parts of the 3.x to 4.0 upgrade"
  },
  "autoload": {
    "psr-4": {
      "Justpilot\\Billomat\\": "src/",
      "Justpilot\\Billomat\\Rector\\": "rector/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Justpilot\\Billomat\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Dimitri Dovgan",
      "email": "dimitri@justpilot.io"
    }
  ],
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true,
      "phpstan/extension-installer": true,
      "php-http/discovery": false
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "@test:unit",
    "test:unit": "phpunit --testsuite=unit",
    "test:integration": "phpunit --testsuite=integration",
    "test:all": "phpunit",
    "test:coverage": [
      "Composer\\Config::disableProcessTimeout",
      "@putenv XDEBUG_MODE=coverage",
      "phpunit --coverage-html=build/coverage --coverage-clover=build/coverage.xml"
    ],
    "lint": "php-cs-fixer fix --dry-run --diff",
    "lint:fix": "php-cs-fixer fix",
    "analyse": "phpstan analyse --memory-limit=512M",
    "refactor": "rector process",
    "refactor:dry": "rector process --dry-run",
    "mutate": [
      "Composer\\Config::disableProcessTimeout",
      "@putenv XDEBUG_MODE=coverage",
      "infection --threads=max"
    ],
    "ci": [
      "@lint",
      "@analyse",
      "@refactor:dry",
      "@generate:check",
      "@test:all"
    ],
    "extract:spec": "php tools/extract-billomat-spec.php",
    "audit:spec": "php tools/audit-spec-vs-code.php",
    "generate": "php tools/generate.php",
    "generate:check": "php tools/generate.php --check",
    "fixtures:record": [
      "Composer\\Config::disableProcessTimeout",
      "php tools/record-fixtures.php"
    ]
  },
  "scripts-descriptions": {
    "test": "PHPUnit-Tests (Unit only, schnell)",
    "test:unit": "Nur Unit-Tests (kein Netz-Zugriff)",
    "test:integration": "Integrations-Tests gegen Billomat-Sandbox (benötigt .env.test.local)",
    "test:all": "Alle Tests inkl. Integration",
    "test:coverage": "Tests + HTML/Clover-Coverage in build/",
    "lint": "Code-Style prüfen (Dry-Run)",
    "lint:fix": "Code-Style automatisch korrigieren",
    "analyse": "PHPStan auf Level max",
    "refactor": "Rector-Regeln anwenden",
    "refactor:dry": "Rector-Vorschläge anzeigen ohne zu schreiben",
    "mutate": "Infection Mutation-Tests ausführen",
    "ci": "Vollständiger lokaler CI-Check (Lint + Analyse + Rector-Dry + Tests)",
    "extract:spec": "Billomat-API-Doku (HTML-Spiegel) in docs/spec/billomat.json überführen",
    "audit:spec": "Vergleicht docs/spec/billomat.json gegen src/ und schreibt docs/audit.md",
    "generate": "Erzeugt Models und Options aus docs/spec/billomat.json + tools/codegen/definitions/",
    "generate:check": "Prüft, ob die generierten Dateien unter src/ aktuell sind",
    "fixtures:record": "Nimmt anonymisierte Contract-Fixtures per GET gegen die Billomat-Sandbox auf (benötigt .env.test.local)"
  }
}
