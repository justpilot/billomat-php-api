{
  "name": "justpilot/billomat-php-api-compat-guzzle",
  "description": "Smoke test: the SDK with Guzzle as the only HTTP client (no Symfony).",
  "type": "project",
  "repositories": [
    {"type": "path", "url": "../../..", "options": {"symlink": true}}
  ],
  "require": {
    "php": "^8.5",
    "guzzlehttp/guzzle": "^7.9",
    "justpilot/billomat-php-api": "*@dev"
  },
  "config": {
    "allow-plugins": {"php-http/discovery": false}
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
